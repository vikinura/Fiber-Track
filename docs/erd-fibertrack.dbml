// Fiber Track - ERD multi tenant & multi vendor
// Tempel ke https://dbdiagram.io untuk menghasilkan diagram dan ekspor SQL.
// Aturan isolasi: semua tabel bertanda tenant_id wajib difilter dari token JWT.

Project fibertrack {
  database_type: 'MySQL'
  Note: 'Platform pelaporan dan pemantauan gangguan jaringan fiber optic'
}

Table tenants {
  id bigint [pk, increment]
  name varchar(150) [not null]
  code varchar(30) [unique, not null]
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  created_at datetime [not null]
  updated_at datetime
}

Table vendors {
  id bigint [pk, increment]
  name varchar(150) [not null]
  contact_person varchar(100)
  phone varchar(30)
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  created_at datetime [not null]
  updated_at datetime
}

Table tenant_vendors {
  id bigint [pk, increment]
  tenant_id bigint [not null]
  vendor_id bigint [not null]
  status varchar(20) [not null, default: 'active']
  created_at datetime [not null]

  indexes {
    (tenant_id, vendor_id) [unique]
  }
}

Table users {
  id bigint [pk, increment]
  tenant_id bigint [note: 'terisi untuk tenant_admin; null untuk super_admin']
  vendor_id bigint [note: 'terisi untuk vendor_admin dan technician']
  name varchar(100) [not null]
  email varchar(150) [unique, not null]
  password_hash varchar(255) [not null]
  phone varchar(30)
  role varchar(20) [not null, note: 'super_admin | tenant_admin | vendor_admin | technician']
  is_active boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime
}

Table areas {
  id bigint [pk, increment]
  tenant_id bigint [not null]
  name varchar(100) [not null]
  description varchar(255)
}

Table odps {
  id bigint [pk, increment]
  tenant_id bigint [not null]
  area_id bigint [not null]
  code varchar(50) [not null]
  latitude decimal(10,7)
  longitude decimal(10,7)

  indexes {
    (tenant_id, code) [unique]
  }
}

Table customers {
  id bigint [pk, increment]
  tenant_id bigint [not null]
  area_id bigint
  odp_id bigint
  name varchar(150) [not null]
  address varchar(255)
  phone varchar(30)
}

Table issue_types {
  id bigint [pk, increment]
  tenant_id bigint [not null]
  name varchar(100) [not null]
}

Table priorities {
  id bigint [pk, increment]
  tenant_id bigint [not null]
  name varchar(50) [not null, note: 'mis. Kritis, Tinggi, Sedang, Rendah']
  sla_hours int [not null, note: 'durasi SLA dalam jam']
}

Table tickets {
  id bigint [pk, increment]
  tenant_id bigint [not null]
  ticket_no varchar(30) [not null]
  customer_id bigint [not null]
  area_id bigint [not null]
  odp_id bigint
  issue_type_id bigint [not null]
  priority_id bigint [not null]
  vendor_id bigint [note: 'terisi setelah tiket diteruskan ke vendor']
  technician_id bigint [note: 'terisi setelah vendor menugaskan teknisi']
  created_by bigint [not null]
  status varchar(20) [not null, default: 'new', note: 'new | forwarded | assigned | in_progress | resolved']
  description text
  latitude decimal(10,7)
  longitude decimal(10,7)
  sla_due_at datetime [not null, note: 'created_at + sla_hours']
  resolved_at datetime
  created_at datetime [not null]
  updated_at datetime

  indexes {
    (tenant_id, ticket_no) [unique]
    (tenant_id, status)
    (tenant_id, vendor_id)
  }
}

Table ticket_histories {
  id bigint [pk, increment]
  ticket_id bigint [not null]
  user_id bigint [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  note text
  created_at datetime [not null]
}

Table ticket_photos {
  id bigint [pk, increment]
  ticket_id bigint [not null]
  uploaded_by bigint [not null]
  file_path varchar(255) [not null]
  caption varchar(255)
  created_at datetime [not null]
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  ticket_id bigint
  message varchar(255) [not null]
  is_read boolean [not null, default: false]
  created_at datetime [not null]
}

Ref: tenant_vendors.tenant_id > tenants.id
Ref: tenant_vendors.vendor_id > vendors.id
Ref: users.tenant_id > tenants.id
Ref: users.vendor_id > vendors.id
Ref: areas.tenant_id > tenants.id
Ref: odps.tenant_id > tenants.id
Ref: odps.area_id > areas.id
Ref: customers.tenant_id > tenants.id
Ref: customers.area_id > areas.id
Ref: customers.odp_id > odps.id
Ref: issue_types.tenant_id > tenants.id
Ref: priorities.tenant_id > tenants.id
Ref: tickets.tenant_id > tenants.id
Ref: tickets.customer_id > customers.id
Ref: tickets.area_id > areas.id
Ref: tickets.odp_id > odps.id
Ref: tickets.issue_type_id > issue_types.id
Ref: tickets.priority_id > priorities.id
Ref: tickets.vendor_id > vendors.id
Ref: tickets.technician_id > users.id
Ref: tickets.created_by > users.id
Ref: ticket_histories.ticket_id > tickets.id
Ref: ticket_histories.user_id > users.id
Ref: ticket_photos.ticket_id > tickets.id
Ref: ticket_photos.uploaded_by > users.id
Ref: notifications.user_id > users.id
Ref: notifications.ticket_id > tickets.id
